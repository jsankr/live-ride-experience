{
  "name": "ridelens",
  "version": "0.1.0",
  "description": "Live motorcycle ride analytics (IMU + GPS + OBD-II) with wrong-side vehicle reporting",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "test:browser": "node scripts/cockpit-browser.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  }
}
